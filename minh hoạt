import matplotlib.pyplot as plt
import numpy as np

# Tạo dữ liệu giả lập cho kích thước tập huấn luyện (Training Set Size)
m = np.linspace(1, 100, 100)

# Khởi tạo khung hình gồm 3 biểu đồ con nằm ngang
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

# ==========================================
# 1. UNDERFITTING (High Bias)
# ==========================================
# Cả train error và validation error đều cao và đi ngang
train_err_under = 4.5 + 0.5 * np.exp(-m / 20) + np.random.normal(0, 0.05, len(m))
val_err_under = 4.8 + 0.5 * np.exp(-m / 20) + np.random.normal(0, 0.05, len(m))

axes[0].plot(m, train_err_under, label='Training Error', color='blue', lw=2)
axes[0].plot(
    m, val_err_under, label='Validation Error', color='orange', lw=2, ls='--'
    )
axes[0].set_title('1. Underfitting (High Bias)', fontsize=12, fontweight='bold')
axes[0].set_xlabel('Training Set Size')
axes[0].set_ylabel('Error')
axes[0].set_ylim(0, 7)
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# ==========================================
# 2. OVERFITTING (High Variance)
# ==========================================
# Train error rất thấp, Validation error cao và có khoảng cách lớn (Gap)
train_err_over = 0.5 + 0.5 * np.exp(-m / 10) + np.random.normal(0, 0.02, len(m))
val_err_over = (
    4.5
    - 2 * np.exp(-m / 30)
    + 0.01 * m
    + np.random.normal(0, 0.05, len(m))
    )

axes[1].plot(m, train_err_over, label='Training Error', color='blue', lw=2)
axes[1].plot(
    m, val_err_over, label='Validation Error', color='orange', lw=2, ls='--'
    )
axes[1].set_title('2. Overfitting (High Variance)', fontsize=12, fontweight='bold')
axes[1].set_xlabel('Training Set Size')
axes[1].set_ylabel('Error')
axes[1].set_ylim(0, 7)
axes[1].legend()
axes[1].grid(True, alpha=0.3)

# ==========================================
# 3. GOOD FIT (Lý tưởng)
# ==========================================
# Cả hai đều thấp, hội tụ và nằm sát nhau
train_err_good = 0.8 + 3.5 * np.exp(-m / 20) + np.random.normal(0, 0.03, len(m))
val_err_good = 1.2 + 3.8 * np.exp(-m / 20) + np.random.normal(0, 0.03, len(m))

axes[2].plot(m, train_err_good, label='Training Error', color='blue', lw=2)
axes[2].plot(
    m, val_err_good, label='Validation Error', color='orange', lw=2, ls='--'
    )
axes[2].set_title('3. Good Fit (Lý tưởng)', fontsize=12, fontweight='bold')
axes[2].set_xlabel('Training Set Size')
axes[2].set_ylabel('Error')
axes[2].set_ylim(0, 7)
axes[2].legend()
axes[2].grid(True, alpha=0.3)

# Hiển thị biểu đồ
plt.tight_layout()
plt.show()