# 5. Đánh giá
# ----------------------------------------------------------------------
def confusion_matrix(y_true, y_pred):
    y_true, y_pred = y_true.ravel(), y_pred.ravel()
    tn = np.sum((y_true == 0) & (y_pred == 0))
    fp = np.sum((y_true == 0) & (y_pred == 1))
    fn = np.sum((y_true == 1) & (y_pred == 0))
    tp = np.sum((y_true == 1) & (y_pred == 1))
    return np.array([[tn, fp], [fn, tp]])


def print_metrics(cm):
    tn, fp, fn, tp = cm.ravel()
    acc = (tp + tn) / cm.sum()
    precision = tp / (tp + fp + 1e-12)
    recall = tp / (tp + fn + 1e-12)  # với ung thư, recall quan trọng nhất (đừng bỏ sót ca ác tính)
    f1 = 2 * precision * recall / (precision + recall + 1e-12)
    print(f"Accuracy : {acc:.4f}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall   : {recall:.4f}")
    print(f"F1-score : {f1:.4f}")


def roc_curve(y_true, y_score):
    y_true, y_score = y_true.ravel(), y_score.ravel()
    thresholds = np.linspace(1, 0, 200)
    tpr, fpr = [], []
    P, N = np.sum(y_true == 1), np.sum(y_true == 0)
    for t in thresholds:
        pred = y_score >= t
        tpr.append(np.sum(pred & (y_true == 1)) / P)
        fpr.append(np.sum(pred & (y_true == 0)) / N)
    tpr, fpr = np.array(tpr), np.array(fpr)
    auc = np.trapezoid(tpr, fpr) if hasattr(np, "trapezoid") else np.trapz(tpr, fpr)
    return fpr, tpr, auc


